#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess


ROOT = Path(__file__).resolve().parent
FIRMWARE = ROOT / "firmware"
COMPILE_COMMANDS = FIRMWARE / "compile_commands.json"


def run(*command: str) -> None:
    subprocess.run(command, cwd=ROOT, check=True)


def refresh_clangd() -> None:
    run("uv", "run", "pio", "run", "-d", "firmware", "-t", "compiledb")

    compiler_paths = {}
    native_databases = (FIRMWARE / ".pio" / "build").glob("*/compile_commands.json")
    for database in native_databases:
        for entry in json.loads(database.read_text()):
            compiler = shlex.split(entry["command"])[0]
            if os.path.isabs(compiler):
                compiler_paths[Path(compiler).name] = compiler

    entries = json.loads(COMPILE_COMMANDS.read_text())
    for entry in entries:
        compiler, separator, arguments = entry["command"].partition(" ")
        absolute_compiler = compiler_paths.get(Path(compiler).name)
        if absolute_compiler:
            entry["command"] = absolute_compiler + separator + arguments

    COMPILE_COMMANDS.write_text(json.dumps(entries, indent=2) + "\n")


def main() -> None:
    parser = argparse.ArgumentParser(description="Local development commands")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("build", help="Build the firmware")
    subparsers.add_parser("upload", help="Build and upload the firmware")
    subparsers.add_parser("monitor", help="Open the firmware serial monitor")
    subparsers.add_parser("clangd", help="Refresh clangd's compilation database")
    args = parser.parse_args()

    if args.command == "build":
        run("uv", "run", "pio", "run", "-d", "firmware")
    elif args.command == "upload":
        run("uv", "run", "pio", "run", "-d", "firmware", "-t", "upload")
    elif args.command == "monitor":
        run("uv", "run", "pio", "device", "monitor", "-d", "firmware")
    else:
        refresh_clangd()


if __name__ == "__main__":
    main()
